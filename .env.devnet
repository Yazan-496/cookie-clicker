# Testing-only overrides. Used by `npm run dev:devnet`.
# Solana devnet is SVM like Cookie Chain, has the Memo program, and free SOL —
# so the full bake path can be validated here without spending COOK.
VITE_RPC_URL=https://api.devnet.solana.com
VITE_EXPLORER_URL=https://explorer.solana.com
VITE_EXPLORER_SUFFIX=?cluster=devnet
VITE_NETWORK_NAME=Solana devnet
